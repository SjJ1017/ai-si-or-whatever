{
  "manifest_version": 3,
  "name": "AI, SI, or Whatever",
  "version": "0.1.1",
  "description": "Read the web in your preferred intelligence terminology. Local rules, with optional TypeSafe Jev decisions.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/store128.png"},
  "action": {"default_popup": "popup.html", "default_title": "AI, SI, or Whatever", "default_icon":{"16":"icons/icon16.png","32":"icons/icon32.png"}},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["engine.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}
